# CargoPilot backend production env template.
# Copy to .env.docker on the server and fill real secrets.

# Public ports used by docker-compose.
# Bind to 127.0.0.1 when Nginx/Caddy terminates HTTPS on the same server.
API_PORT=4000
API_BIND=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_BIND=127.0.0.1
REDIS_PORT=6379
REDIS_BIND=127.0.0.1

# If using the bundled Postgres container.
POSTGRES_DB=cargopilot
POSTGRES_USER=cargopilot
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://cargopilot:change_me@postgres:5432/cargopilot?schema=public

# If using Neon/RDS instead, replace DATABASE_URL above and keep postgres service disabled manually.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&schema=public

NODE_ENV=production
PORT=4000
TRUST_PROXY=true
FASTIFY_BODY_LIMIT_BYTES=5242880

# Required stable secrets. Generate once and never rotate casually.
JWT_SECRET=replace_with_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_long_random_secret
PAYMENT_CONFIG_MASTER_KEY=replace_with_32_plus_byte_random_secret
INTEGRATION_CONFIG_MASTER_KEY=replace_with_32_plus_byte_random_secret

# First production owner account. Used by:
# docker compose --env-file .env.docker exec api node dist/src/scripts/bootstrap-erp-access.js
ERP_OWNER_EMAIL=admin@example.com
ERP_OWNER_PASSWORD=replace_with_temporary_strong_password
ERP_OWNER_NAME=Super Admin
ERP_SUPER_ADMIN_ROLE_CODE=super_admin

# Public URLs.
CLIENT_URL=https://app.example.com
CHECKOUT_RETURN_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com,https://www.app.example.com
ADDITIONAL_ALLOWED_ORIGINS=

# Redis.
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_PREFIX=cargopilot
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_OP_TIMEOUT_MS=2500
REDIS_READY_WAIT_MS=1500
REDIS_UNAVAILABLE_COOLDOWN_MS=2000

# Payments.
# Provider API keys and webhook secrets are saved in Admin UI -> Billing & Pricing -> Payment Providers.
# Stripe webhook URL in Stripe dashboard:
# https://api.example.com/api/payments/stripe/callback
PAYMENTS_ENABLED=true

# S3 for labels, invoices, and proof photos.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DELIVERY_PROOF_MAX_PHOTO_BYTES=6291456

# Analytics and realtime.
ANALYTICS_LOG_LEVEL=warn
ANALYTICS_WARMUP_IN_API=true
ANALYTICS_WORKER_IN_PROCESS=false
ANALYTICS_OUTBOX_ENABLED=true
ANALYTICS_OUTBOX_IN_API=false
ANALYTICS_OUTBOX_LEADER_LOCK_ENABLED=true
ANALYTICS_OUTBOX_LOCK_TIMEOUT_MS=4000
LIVE_MAP_DRIVER_LOCATION_TTL_SEC=43200
LIVE_MAP_DRIVER_PRESENCE_TTL_SEC=86400
LIVE_MAP_DRIVER_ONLINE_SEC=70
LIVE_MAP_DRIVER_IDLE_SEC=180
LIVE_MAP_DRIVER_STALE_SEC=600
LIVE_MAP_STREAM_HEARTBEAT_MS=25000

# Support automation.
SUPPORT_RULES_ENABLED=true
SUPPORT_SLA_MONITOR_ENABLED=true
SUPPORT_AUTO_TRIAGE_ENABLED=true
SUPPORT_RULES_LOG_MIN_INTERVAL_MS=300000
SUPPORT_RULES_TRIGGER_ON_WORKER_REBUILD=false

# Label worker.
ORDER_LABEL_MODE=queue
ORDER_LABEL_AUTO_FALLBACK=true
ORDER_LABEL_WORKER_POLL_MS=2000
ORDER_LABEL_WORKER_BATCH_SIZE=10
ORDER_LABEL_MAX_ATTEMPTS=5
ORDER_LABEL_RETRY_BASE_MS=15000
ORDER_LABEL_RETRY_CAP_MS=300000
ORDER_LABEL_SECOND_CODE_MODE=barcode

# Integration outbox and partner webhooks.
INTEGRATION_OUTBOX_ENABLED=true
INTEGRATION_OUTBOX_IN_API=false
INTEGRATION_OUTBOX_BATCH_SIZE=50
INTEGRATION_OUTBOX_IDLE_MS=1500
INTEGRATION_OUTBOX_ERROR_SLEEP_MS=2000
INTEGRATION_OUTBOX_LOCK_TIMEOUT_MS=3000
INTEGRATION_OUTBOX_PROVIDER_TIMEOUT_MS=10000
INTEGRATION_WEBHOOK_SIGNATURE_HEADER=x-signature
INTEGRATION_WEBHOOK_TIMESTAMP_HEADER=x-signature-timestamp
INTEGRATION_WEBHOOK_MAX_SKEW_SECONDS=300

# Operational limits.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=120
MAX_EXPORT_ROWS=20000
ORDER_BULK_MAX_IDS=100
