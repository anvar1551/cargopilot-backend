{
  "name": "cargopilot-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:stack": "node scripts/dev/run-dev-stack.js",
    "dev:stack:fake": "node scripts/dev/run-dev-stack.js --fake-carrier",
    "worker:analytics": "ts-node-dev --respawn --transpile-only src/workers/analytics.worker.ts",
    "worker:analytics-outbox": "ts-node-dev --respawn --transpile-only src/workers/analytics-outbox.worker.ts",
    "worker:integration-outbox": "ts-node-dev --respawn --transpile-only src/workers/integration-outbox.worker.ts",
    "worker:labels": "ts-node-dev --respawn --transpile-only src/workers/order-label.worker.ts",
    "worker:labels:once": "ts-node-dev --transpile-only src/workers/order-label.worker.ts --once",
    "bootstrap:erp-access": "ts-node-dev --transpile-only src/scripts/bootstrap-erp-access.ts",
    "bootstrap:support": "ts-node-dev --transpile-only src/scripts/bootstrap-support.ts",
    "seed:permissions": "ts-node-dev --transpile-only src/scripts/seed-permissions.ts",
    "smoke:payments-local": "ts-node-dev --transpile-only src/scripts/payments-local-smoke.ts",
    "fake:carrier": "ts-node-dev --transpile-only scripts/integration/fake-carrier.ts",
    "smoke:carrier-integration": "ts-node-dev --transpile-only scripts/integration/carrier-booking-smoke.ts",
    "smoke:route-template-carrier": "ts-node-dev --transpile-only scripts/integration/route-template-carrier-smoke.ts",
    "test:integration:carrier": "ts-node-dev --transpile-only scripts/integration/carrier-booking-smoke.ts",
    "test:integration:route-template-carrier": "ts-node-dev --transpile-only scripts/integration/route-template-carrier-smoke.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "start:worker:analytics": "node dist/src/workers/analytics.worker.js",
    "start:worker:analytics-outbox": "node dist/src/workers/analytics-outbox.worker.js",
    "start:worker:integration-outbox": "node dist/src/workers/integration-outbox.worker.js",
    "start:worker:labels": "node dist/src/workers/order-label.worker.js",
    "start:bootstrap:erp-access": "node dist/src/scripts/bootstrap-erp-access.js",
    "start:bootstrap:support": "node dist/src/scripts/bootstrap-support.js",
    "start:seed:permissions": "node dist/src/scripts/seed-permissions.js",
    "load:orders:read": "k6 run tests/load/orders-read.k6.js",
    "test": "jest --detectOpenHandles",
    "test:integration:realtime": "ts-node-dev --transpile-only scripts/integration/realtime-smoke.ts",
    "test:integration:redis": "ts-node-dev --transpile-only scripts/integration/redis-resilience.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.928.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sap/hana-client": "^2.26.18",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.8.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "stripe": "^19.2.0",
    "uuid": "^9.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bwip-js": "^3.2.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
