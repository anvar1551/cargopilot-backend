# App
PORT=4000
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
PAYMENT_CONFIG_MASTER_KEY=replace-with-stable-32-byte-random-secret
INTEGRATION_CONFIG_MASTER_KEY=replace-with-stable-32-byte-random-secret
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL=30d
AUTH_DB_LOOKUP_MODE=token_or_cache
AUTH_USER_CACHE_TTL_MS=300000
ACCESS_SCOPE_CACHE_TTL_MS=120000
TRUST_PROXY=1
JSON_BODY_LIMIT=5mb
ERP_OWNER_EMAIL=
ERP_MANAGER_EMAILS=
ERP_DRIVER_EMAILS=
ERP_WAREHOUSE_EMAILS=
ERP_CUSTOMER_EMAILS=

# Database
DATABASE_URL=
# Direct non-pooler Postgres URL for Prisma migrations. Use Neon direct endpoint, not `-pooler`.
DIRECT_URL=

# CORS
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ADDITIONAL_ALLOWED_ORIGINS=

# Redis (optional but recommended for scale)
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=cargopilot
REDIS_RATE_LIMIT_PREFIX=cargopilot:ratelimit
RATE_LIMIT_REDIS_STORE_ENABLED=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_OP_TIMEOUT_MS=2500
REDIS_READY_WAIT_MS=1500
REDIS_UNAVAILABLE_COOLDOWN_MS=2000
LIVE_MAP_REDIS_GEO_TIMEOUT_MS=2500
LIVE_MAP_REDIS_LOCATIONS_TIMEOUT_MS=2500
LIVE_MAP_REDIS_PRESENCES_TIMEOUT_MS=2500
LIVE_MAP_REDIS_SNAPSHOT_CACHE_TIMEOUT_MS=1500

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=120
ANALYTICS_RATE_LIMIT_WINDOW_MS=60000
ANALYTICS_RATE_LIMIT_MAX=120
EXPORT_RATE_LIMIT_WINDOW_MS=600000
EXPORT_RATE_LIMIT_MAX=20
LIVE_MAP_SNAPSHOT_RATE_LIMIT_WINDOW_MS=60000
LIVE_MAP_SNAPSHOT_RATE_LIMIT_MAX=240
LIVE_MAP_STREAM_RATE_LIMIT_WINDOW_MS=60000
LIVE_MAP_STREAM_RATE_LIMIT_MAX=60
DRIVER_LOCATION_RATE_LIMIT_WINDOW_MS=60000
DRIVER_LOCATION_RATE_LIMIT_MAX=180
DRIVER_PRESENCE_RATE_LIMIT_WINDOW_MS=60000
DRIVER_PRESENCE_RATE_LIMIT_MAX=240

# Caching / export guard
# Analytics (minimal)
ANALYTICS_LOG_LEVEL=warn
ANALYTICS_CACHE_TTL_MS=300000
ANALYTICS_DEFAULT_RANGE_DAYS=30
ANALYTICS_STALE_HOURS=48
ANALYTICS_CACHE_JITTER_PCT=0.15
ANALYTICS_STREAM_HEARTBEAT_MS=25000
ANALYTICS_STREAM_REPLAY_MAX_EVENTS=250
ANALYTICS_STREAM_REFRESH_MS=0
ANALYTICS_SLA_POLICY_DB_ENABLED=false
ANALYTICS_WARMUP_ENABLED=true
ANALYTICS_WARMUP_IN_API=true
ANALYTICS_WARMUP_INTERVAL_MS=240000
ANALYTICS_WORKER_IN_PROCESS=false
ANALYTICS_WORKER_HEALTH_LOG_ENABLED=false
ANALYTICS_OUTBOX_ENABLED=true
ANALYTICS_OUTBOX_IN_API=false
ANALYTICS_OUTBOX_LEADER_LOCK_ENABLED=true
ANALYTICS_OUTBOX_LOCK_TIMEOUT_MS=4000
OPS_MAX_DURATION_SAMPLES=2000
OPS_SSE_RECONNECT_WINDOW_MS=12000
OPS_SSE_CLIENT_KEEP_MS=360000
OPS_WORKER_LAG_ALERT_MS=30000
OPS_ANALYTICS_P95_ALERT_MS=1500
OPS_CACHE_HIT_ALERT_RATIO=0.7
MANAGER_OVERVIEW_CACHE_TTL_MS=60000
MANAGER_DRIVERS_CACHE_TTL_MS=120000
LIVE_MAP_SNAPSHOT_CACHE_TTL_MS=45000
LIVE_MAP_DRIVER_PROFILE_CACHE_TTL_MS=60000
ORDER_LIST_CACHE_TTL_MS=5000
ORDER_LIST_CACHE_MAX_ENTRIES=500
MAX_EXPORT_ROWS=20000
LIVE_MAP_DRIVER_LOCATION_TTL_SEC=43200
LIVE_MAP_DRIVER_PRESENCE_TTL_SEC=86400
LIVE_MAP_DRIVER_ONLINE_SEC=70
LIVE_MAP_DRIVER_IDLE_SEC=180
LIVE_MAP_DRIVER_STALE_SEC=600
LIVE_MAP_DELTA_MIN_DISTANCE_M=25
LIVE_MAP_DELTA_MAX_INTERVAL_SEC=10
LIVE_MAP_SNAPSHOT_ORDER_LIMIT=300
LIVE_MAP_RECENT_HOURS=72
LIVE_MAP_STREAM_HEARTBEAT_MS=25000
DRIVER_NOTIFICATIONS_RETENTION_DAYS=30
DRIVER_NOTIFICATIONS_CLEANUP_INTERVAL_MS=86400000
SUPPORT_RULES_LOG_MIN_INTERVAL_MS=300000
SUPPORT_RULES_TRIGGER_ON_WORKER_REBUILD=false

AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DELIVERY_PROOF_MAX_PHOTO_BYTES=6291456

# Payments
PAYMENTS_ENABLED=false
# Provider credentials are encrypted in DB through the admin UI.

# Order labels
ORDER_LABEL_MODE=queue
ORDER_LABEL_BLOCKING=false
ORDER_LABEL_AUTO_FALLBACK=true
ORDER_LABEL_FALLBACK_DELAY_MS=15000
ORDER_LABEL_STALE_PROCESSING_MS=300000
ORDER_LABEL_MAX_ATTEMPTS=5
ORDER_LABEL_RETRY_BASE_MS=15000
ORDER_LABEL_RETRY_CAP_MS=300000
ORDER_LABEL_WORKER_POLL_MS=2000
ORDER_LABEL_WORKER_BATCH_SIZE=10

# Integrations webhook gateway (Phase 2)
# Per-provider secret (example):
# INTEGRATION_WEBHOOK_SECRET_DHL=replace-me
INTEGRATION_WEBHOOK_SECRETS_JSON=
INTEGRATION_WEBHOOK_SIGNATURE_HEADER=x-signature
INTEGRATION_WEBHOOK_TIMESTAMP_HEADER=x-signature-timestamp
INTEGRATION_WEBHOOK_MAX_SKEW_SECONDS=300

# Integrations outbox worker (Phase 3)
INTEGRATION_OUTBOX_ENABLED=true
INTEGRATION_OUTBOX_IN_API=false
INTEGRATION_OUTBOX_BATCH_SIZE=50
INTEGRATION_OUTBOX_IDLE_MS=1500
INTEGRATION_OUTBOX_ERROR_SLEEP_MS=2000
INTEGRATION_OUTBOX_PROCESSING_TIMEOUT_MS=120000
INTEGRATION_OUTBOX_RETRY_BASE_MS=5000
INTEGRATION_OUTBOX_RETRY_CAP_MS=600000
INTEGRATION_OUTBOX_RETRY_JITTER_PCT=0.2
INTEGRATION_OUTBOX_LEADER_LOCK_ENABLED=true
INTEGRATION_OUTBOX_LOCK_TTL_SEC=20
INTEGRATION_OUTBOX_LOCK_TIMEOUT_MS=3000
INTEGRATION_OUTBOX_LOCK_WAIT_MS=2000
INTEGRATION_OUTBOX_PROVIDER_TIMEOUT_MS=10000

# Phase 4 adapters (examples for provider code = DHL, ESKIZ)
# INTEGRATION_CARRIER_BASE_URL_DHL=https://partner.example.com/api
# INTEGRATION_CARRIER_TOKEN_DHL=replace-me
# INTEGRATION_CARRIER_API_KEY_DHL=replace-me
# INTEGRATION_CARRIER_API_KEY_HEADER_DHL=x-api-key
# INTEGRATION_SMS_BASE_URL_ESKIZ=https://sms.example.com/api
# INTEGRATION_SMS_TOKEN_ESKIZ=replace-me
# INTEGRATION_SMS_API_KEY_ESKIZ=replace-me
# INTEGRATION_SMS_API_KEY_HEADER_ESKIZ=x-api-key

