// CargoPilot bounded-context Prisma declarations.
// Loaded through the multi-file schema configured in prisma.config.ts.

enum CashCollectionKind {
  cod
  service_charge
}

enum CashCollectionStatus {
  expected
  held
  settled
  cancelled
}

enum CashHolderType {
  none
  driver
  warehouse
  pickup_point
  finance
}

enum CashCollectionEventType {
  expected
  collected
  handoff
  settled
  adjusted
  cancelled
}

model CashCollection {
 serviceObligations OrderServiceCashObligation[] @relation("ServiceObligationCollection")
  RestrictedCashReceipt_r1 RestrictedCashReceipt[] @relation("RestrictedCashReceipt_r1")
  RestrictedCashState_r1 RestrictedCashState[] @relation("RestrictedCashState_r1")
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  kind   CashCollectionKind
  status CashCollectionStatus @default(expected)

  expectedAmount  Float
  collectedAmount Float?
  currency        String?

  currentHolderType        CashHolderType @default(none)
  currentHolderUserId      String?        @db.Uuid
  currentHolderUser        User?          @relation("CashCollectionHolderUser", fields: [currentHolderUserId], references: [id])
  currentHolderWarehouseId String?        @db.Uuid
  currentHolderWarehouse   Warehouse?     @relation("CashCollectionHolderWarehouse", fields: [currentHolderWarehouseId], references: [id])
  currentHolderLabel       String?

  collectedAt DateTime?
  settledAt   DateTime?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events CashCollectionEvent[]
  custodyOperations CashCustodyOperation[]

  @@unique([orderId, kind])
  @@unique([orderId, id], map: "CashCollection_order_identity_key")
  @@index([status])
  @@index([currentHolderType, status])
  @@index([currentHolderUserId, status])
  @@index([currentHolderWarehouseId, status])
}

model CashCollectionEvent {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  cashCollectionId String         @db.Uuid
  cashCollection   CashCollection @relation(fields: [cashCollectionId], references: [id], onDelete: Cascade)

  eventType CashCollectionEventType
  amount    Float?
  note      String?

  fromHolderType CashHolderType?
  fromHolderId   String?
  fromHolderName String?

  toHolderType CashHolderType?
  toHolderId   String?
  toHolderName String?

  actorId   String? @db.Uuid
  actor     User?   @relation("CashCollectionEventActor", fields: [actorId], references: [id])
  actorRole String?

  createdAt DateTime @default(now())

  custodyOperation CashCustodyOperation?

  @@unique([cashCollectionId, id], map: "CashCollectionEvent_collection_identity_key")

  @@index([cashCollectionId, createdAt])
  @@index([actorId, createdAt])
}

// New operation receipts are fully owned; legacy cash columns remain compatibility mirrors.
model CashCustodyOperation {
  RestrictedCashTransferOffer_r1 RestrictedCashTransferOffer[] @relation("RestrictedCashTransferOffer_r1")
  RestrictedCashState_r2 RestrictedCashState[] @relation("RestrictedCashState_r2")
 @@unique([collectionId,eventId,tenantId,companyId,orderId,amount,currency],map:"Cash_operation_basis_key")
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [tenantId, orderId, companyId], references: [tenantId, id, ownerOrgId], onDelete: Restrict, onUpdate: Restrict, map: "CashCustodyOperation_order_owner_fkey")
  collectionId String @db.Uuid
  collection CashCollection @relation(fields: [orderId, collectionId], references: [orderId, id], onDelete: Restrict, onUpdate: Restrict, map: "CashCustodyOperation_collection_fkey")
  eventId String @unique @db.Uuid
  event CashCollectionEvent @relation(fields: [collectionId, eventId], references: [cashCollectionId, id], onDelete: Restrict, onUpdate: Restrict, map: "CashCustodyOperation_event_fkey")
  actorId String @db.Uuid
  companyMembershipId String @db.Uuid
  actorMembership CompanyMembership @relation(fields: [companyMembershipId, actorId, tenantId, companyId], references: [id, userId, tenantId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "CashCustodyOperation_actor_context_fkey")
  operationKey String
  action String
  fingerprint String
  amount Decimal @db.Decimal(20, 4)
  currency String
  resultJson Json
  createdAt DateTime @default(now())

  @@unique([tenantId, companyId, operationKey])
  @@unique([collectionId, eventId], map: "CashCustodyOperation_event_identity_key")
  @@index([tenantId, companyId, orderId, createdAt])
}
