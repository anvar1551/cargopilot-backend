// CargoPilot bounded-context Prisma declarations.
// Loaded through the multi-file schema configured in prisma.config.ts.

enum MembershipStatus {
  active
  invited
  suspended
}

enum MembershipScopeType {
  company
  branch
  warehouse
  agent
  pickup_point
  carrier
  client
}

model Role {
  driverGrants CompanyDriverEligibility[]
  operationalGrants CompanyOperationalGrant[]
  onboardingReceipts TenantOnboardingReceipt[]
  id   String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  code String
  name String

  companyId String?       @db.Uuid
  company   Organization? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  isSystem    Boolean  @default(false)
  isOwnerRole Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([companyId, code])
  @@unique([id, companyId], map: "Role_onboarding_company_key")
  @@index([code])
  @@index([companyId, isSystem])
}

model Permission {
  id          String  @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([resource, action])
}

model RolePermission {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model CompanyMembership {
 serviceInstructionsActor OrderServicePaymentInstruction[] @relation("ServiceInstructionActor")
 serviceInstructionsBridge OrderServicePaymentInstruction[] @relation("ServiceInstructionBridge")
  RestrictedCashReceipt_r2 RestrictedCashReceipt[] @relation("RestrictedCashReceipt_r2")
  RestrictedCashTransferOffer_r3 RestrictedCashTransferOffer[] @relation("RestrictedCashTransferOffer_r3")
  RestrictedCashTransferOffer_r2 RestrictedCashTransferOffer[] @relation("RestrictedCashTransferOffer_r2")
  RestrictedCashState_r3 RestrictedCashState[] @relation("RestrictedCashState_r3")
  entitySetupAuthorities IssuingEntitySetupAuthority[] @relation("EntitySetupAuthorityMember")
  entitySetupAuthorityBridges IssuingEntitySetupAuthority[] @relation("EntitySetupAuthorityBridge")
  entitySetupProposals IssuingEntitySetupProposal[] @relation("EntitySetupProposalMember")
  entitySetupProposalBridges IssuingEntitySetupProposal[] @relation("EntitySetupProposalBridge")
  entitySetupActions IssuingEntitySetupAction[] @relation("EntitySetupActionMember")
  entitySetupActionBridges IssuingEntitySetupAction[] @relation("EntitySetupActionBridge")
  FinancialGrantProposal_proposer FinancialGrantProposal[] @relation("FinancialGrantProposal_proposer")
  CashCapabilityGrantProposal_proposer CashCapabilityGrantProposal[] @relation("CashCapabilityGrantProposal_proposer")
  FinancialGrantProposal_target FinancialGrantProposal[] @relation("FinancialGrantProposal_target")
  CashCapabilityGrantProposal_target CashCapabilityGrantProposal[] @relation("CashCapabilityGrantProposal_target")
  FinancialGrantAction_target FinancialGrantAction[] @relation("FinancialGrantAction_target")
  CashCapabilityGrantAction_target CashCapabilityGrantAction[] @relation("CashCapabilityGrantAction_target")
  FinancialGrantAction_actor FinancialGrantAction[] @relation("FinancialGrantAction_actor")
  CashCapabilityGrantAction_actor CashCapabilityGrantAction[] @relation("CashCapabilityGrantAction_actor")
  FinancialDelegationAuthority_member FinancialDelegationAuthority[] @relation("FinancialDelegationAuthority_member")
  CashCapabilityDelegationAuthority_member CashCapabilityDelegationAuthority[] @relation("CashCapabilityDelegationAuthority_member")
  FinancialDelegationAuthority_bridge FinancialDelegationAuthority[] @relation("FinancialDelegationAuthority_bridge")
  CashCapabilityDelegationAuthority_bridge CashCapabilityDelegationAuthority[] @relation("CashCapabilityDelegationAuthority_bridge")
  FinancialMembershipGrant_member FinancialMembershipGrant[] @relation("FinancialMembershipGrant_member")
  CashCapabilityMembershipGrant_member CashCapabilityMembershipGrant[] @relation("CashCapabilityMembershipGrant_member")
  FinancialMembershipGrant_bridge FinancialMembershipGrant[] @relation("FinancialMembershipGrant_bridge")
  CashCapabilityMembershipGrant_bridge CashCapabilityMembershipGrant[] @relation("CashCapabilityMembershipGrant_bridge")
 warehouseProvisioners WarehouseProvisioningAuthority[] @relation("WarehouseProvisioner")
 warehouseProvisionerBridges WarehouseProvisioningAuthority[] @relation("WarehouseProvisionerBridge")
 warehouseProvisioningActions WarehouseProvisioningAction[] @relation("WarehouseProvisioningActor")
 warehouseProvisioningActionBridges WarehouseProvisioningAction[] @relation("WarehouseProvisioningActorBridge")
  driverAuthorities CompanyDriverDelegationAuthority[] @relation("DriverDelegatorOwner")
  driverAuthorityBridges CompanyDriverDelegationAuthority[] @relation("DriverDelegatorBridge")
  driverInvitations CompanyDriverInvitation[] @relation("DriverInvitationAccepted")
  driverEligibility CompanyDriverEligibility? @relation("DriverOperationalGrantOwner")
  driverEligibilityBridges CompanyDriverEligibility[] @relation("DriverOperationalGrantBridge")
  driverActions CompanyDriverAction[] @relation("DriverDelegationActionActor")
  driverTargets CompanyDriverAction[] @relation("DriverDelegationActionTarget")
  driverRecipientTargets CompanyDriverAction[] @relation("DriverDelegationRecipientTarget")
  delegationOwners CompanyDelegationAuthority[] @relation("DelegatorOwner")
  delegationBridges CompanyDelegationAuthority[] @relation("DelegatorBridge")
  acceptedInvitations CompanyInvitation[] @relation("InvitationAccepted")
  operationalOwners CompanyOperationalGrant[] @relation("OperationalGrantOwner")
  operationalBridges CompanyOperationalGrant[] @relation("OperationalGrantBridge")
  delegationActions CompanyDelegationAction[] @relation("DelegationActionActor")
  delegatedTargets CompanyDelegationAction[] @relation("DelegationActionTarget")
  delegationRecipientTargets CompanyDelegationAction[] @relation("DelegationRecipientTarget")
  onboardingBridges TenantOnboardingReceipt[] @relation("OnboardingBridge")
  onboardingOwners TenantOnboardingReceipt[] @relation("OnboardingOwner")
  custodyActions OrderCustodyAction[] @relation("CustodyActor")
  custodyBridges OrderCustodyAction[] @relation("CustodyBridge")
  custodyDrivers OrderCustodyAction[] @relation("CustodyDriver")
  InvoiceIssuanceReceipt_actor InvoiceIssuanceReceipt[] @relation("InvoiceIssuanceReceipt_actor")
  InvoiceIssuanceReceipt_bridge InvoiceIssuanceReceipt[] @relation("InvoiceIssuanceReceipt_bridge")
  OrderBillTo_actor OrderBillTo[] @relation("OrderBillTo_actor")
  OrderBillTo_bridge OrderBillTo[] @relation("OrderBillTo_bridge")
  OrderPriceSnapshot_actor OrderPriceSnapshot[] @relation("OrderPriceSnapshot_actor")
  OrderPriceSnapshot_bridge OrderPriceSnapshot[] @relation("OrderPriceSnapshot_bridge")
  OrderPriceApproval_actor OrderPriceApproval[] @relation("OrderPriceApproval_actor")
  OrderPriceApproval_bridge OrderPriceApproval[] @relation("OrderPriceApproval_bridge")
  billingPolicies BillingPolicyVersion[] @relation("BillingPolicyActor")
  billingPolicyBridges BillingPolicyVersion[] @relation("BillingPolicyBridge")
  billingDecisions BillingPolicyDecision[] @relation("BillingDecisionActor")
  billingDecisionBridges BillingPolicyDecision[] @relation("BillingDecisionBridge")
  tariffVersions TariffConfigurationVersion[] @relation("TariffVersionActor")
  tariffVersionBridges TariffConfigurationVersion[] @relation("TariffVersionBridge")
  tariffDecisions TariffPublicationDecision[] @relation("TariffDecisionActor")
  tariffDecisionBridges TariffPublicationDecision[] @relation("TariffDecisionBridge")
  publicationRepairs CarrierPublicationRepair[] @relation("PublicationRepairCompany")
  publicationRepairBridges CarrierPublicationRepair[] @relation("PublicationRepairBridge")
  accountCreationReceipts FinanceAccountCreationReceipt[] @relation("AccountReceiptCompany")
  credentialSecurityEvents CredentialSecurityEvent[] @relation("CredentialAuditCompany")
  credentialSecurityBridges CredentialSecurityEvent[] @relation("CredentialAuditBridge")
  orderCreationIntents OrderCreationIntent[] @relation("OrderCreationCompany")
  orderCreationBridges OrderCreationIntent[] @relation("OrderCreationBridge")
  providerConfigurationActions IntegrationProviderConfigurationVersion[] @relation("ProviderConfigurationActor")
  templateConfigurationActions RouteTemplateConfigurationVersion[] @relation("TemplateConfigurationActor")
  routingConfigurationActions CarrierRoutingConfigurationVersion[] @relation("RoutingConfigurationActor")
  routingConfigurationBridges CarrierRoutingConfigurationVersion[] @relation("RoutingConfigurationBridge")
  templateConfigurationBridges RouteTemplateConfigurationVersion[] @relation("TemplateConfigurationBridge")
  providerConfigurationBridges IntegrationProviderConfigurationVersion[] @relation("ProviderConfigurationBridge")
  draftDocuments FinanceDocument[] @relation("DraftCompany")
  bridgedDraftDocuments FinanceDocument[] @relation("DraftBridge")
  assignedSupportTickets SupportTicket[] @relation("SupportOwnerMembership")
  proofSubmissions ProofSubmission[] @relation("ProofSubmissionCompany")
  proofSubmissionBridges ProofSubmission[] @relation("ProofSubmissionBridge")
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String       @db.Uuid
  company   Organization @relation("CompanyMembershipCompany", fields: [companyId], references: [id], onDelete: Cascade)

  // Nullable compatibility bridge during tenant expansion. The SQL migration
  // requires tenantId and tenantMembershipId to be both null or both populated.
  tenantId           String?           @db.Uuid
  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?           @db.Uuid
  tenantMembership   TenantMembership? @relation("TenantMembershipCompanyMemberships", fields: [tenantMembershipId, userId, tenantId], references: [id, userId, tenantId], onDelete: Restrict, map: "CompanyMembership_tenant_bridge_fkey")
  tenantCompany      Organization?     @relation("CompanyMembershipTenantCompany", fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "CompanyMembership_tenant_company_fkey")

  branchId String?       @db.Uuid
  branch   Organization? @relation("CompanyMembershipBranch", fields: [branchId], references: [id], onDelete: SetNull)

  status MembershipStatus @default(active)

  authorizationVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles  MembershipRole[]
  scopes MembershipScope[]
  refreshSessions UserRefreshSession[] @relation("RefreshSessionCompanyMembership")
  notifications UserNotification[] @relation("UserNotificationRecipientMembership")
  cashCustodyOperations CashCustodyOperation[]

  @@unique([userId, companyId])
  @@unique([id, tenantId, companyId], map: "CompanyMembership_delegation_context_key")
  @@unique([id, tenantMembershipId, userId, tenantId], map: "CompanyMembership_session_bridge_key")
  @@unique([id, userId, tenantId, companyId], map: "CompanyMembership_notification_owner_key")
  @@index([companyId, status])
  @@index([tenantId, status])
  @@index([tenantMembershipId])
  @@index([branchId])
}

enum CredentialSecurityAction {
  PASSWORD_CHANGED
  LOGIN_ACCEPTED
  LOGOUT_ACCEPTED
}

model CredentialSecurityEvent {
  id                  String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  actorUserId         String @db.Uuid
  tenantId            String @db.Uuid
  tenantMembershipId  String @db.Uuid
  companyId           String @db.Uuid
  companyMembershipId String @db.Uuid
  companyMembership CompanyMembership @relation("CredentialAuditCompany", fields: [companyMembershipId, actorUserId, tenantId, companyId], references: [id, userId, tenantId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "CredentialSecurityEvent_company_fkey")
  membershipBridge CompanyMembership @relation("CredentialAuditBridge", fields: [companyMembershipId, tenantMembershipId, actorUserId, tenantId], references: [id, tenantMembershipId, userId, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "CredentialSecurityEvent_bridge_fkey")
  action    CredentialSecurityAction
  createdAt DateTime @default(now())

  @@index([tenantId, companyId, actorUserId, createdAt], map: "CredentialSecurityEvent_owner_time_idx")
}

model MembershipRole {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  membershipId String            @db.Uuid
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String            @db.Uuid
  role         Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([membershipId, roleId])
  @@index([roleId])
}

model MembershipScope {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  membershipId String              @db.Uuid
  membership   CompanyMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  scopeType    MembershipScopeType
  scopeRefId   String              @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([membershipId, scopeType, scopeRefId])
  @@index([scopeType, scopeRefId])
  @@index([membershipId])
}

model User {
  driverInvitationAcceptances CompanyDriverAction[]
  invitationAcceptances CompanyDelegationAction[]
  onboardingReceipts TenantOnboardingReceipt[]
  id       String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name     String
  email    String @unique
  password String

  driverType            DriverType?
  liveLocationEnabled   Boolean             @default(true)
  liveLocationUpdatedAt DateTime            @default(now())
  memberships           CompanyMembership[]
  tenantMemberships     TenantMembership[]

  // ✅ link user -> customer entity (person/company)
  customerEntityId String?         @db.Uuid
  customerEntity   CustomerEntity? @relation("CustomerEntityUsers", fields: [customerEntityId], references: [id])

  warehouseId       String?                 @db.Uuid
  warehouse         Warehouse?              @relation(fields: [warehouseId], references: [id])
  warehouseAccesses DriverWarehouseAccess[]

  orders       Order[] @relation("CustomerOrders")
  driverOrders Order[] @relation("DriverOrders")

  createdAt DateTime @default(now())

  invoices                  Invoice[]
  trackingEvents            Tracking[]            @relation("TrackingActor")
  heldCashCollections       CashCollection[]      @relation("CashCollectionHolderUser")
  cashCollectionActorEvents CashCollectionEvent[] @relation("CashCollectionEventActor")
  notifications             UserNotification[]
  createdOrderDocuments     OrderDocument[]       @relation("OrderDocumentCreatedBy")
  refreshSessions           UserRefreshSession[]

  @@index([createdAt])
  @@index([warehouseId, createdAt])
}

model UserRefreshSession {
  id String @id @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Future session selection fields. All three remain null for legacy sessions;
  // the migration check requires all three when any one is populated.
  tenantId           String?            @db.Uuid
  tenant             Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantMembershipId String?            @db.Uuid
  companyMembershipId String?           @db.Uuid
  companyMembership  CompanyMembership? @relation("RefreshSessionCompanyMembership", fields: [companyMembershipId, tenantMembershipId, userId, tenantId], references: [id, tenantMembershipId, userId, tenantId], onDelete: Restrict, map: "UserRefreshSession_membership_bridge_fkey")

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  rotationDepth       Int                 @default(0)
  replacementDepth    Int?
  replacedBySessionId String?              @unique(map: "UserRefreshSession_successor_key") @db.Uuid
  replacedBySession   UserRefreshSession?  @relation("RefreshSessionReplacement", fields: [replacedBySessionId, userId, tenantId, tenantMembershipId, companyMembershipId, replacementDepth], references: [id, userId, tenantId, tenantMembershipId, companyMembershipId, rotationDepth], onDelete: Restrict, onUpdate: Restrict, map: "UserRefreshSession_lineage_fkey")
  replacedSessions    UserRefreshSession[] @relation("RefreshSessionReplacement")

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([tenantId, userId, revokedAt])
  @@index([companyMembershipId])
  @@index([expiresAt])
  @@unique([id, userId, tenantId, tenantMembershipId, companyMembershipId, rotationDepth], map: "UserRefreshSession_lineage_identity_key")
  @@index([userId, revokedAt, expiresAt])
}
