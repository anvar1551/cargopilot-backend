// CargoPilot bounded-context Prisma declarations.
// Loaded through the multi-file schema configured in prisma.config.ts.

enum OrganizationType {
  company
  branch
  agent
  pickup_point
  carrier
  client
}

enum WarehouseType {
  warehouse
  pickup_point
}

enum DriverType {
  local
  linehaul
}

model Organization {
  id   String           @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name String
  type OrganizationType
  code String?          @unique

  tenantId String? @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  parentOrgId String?        @db.Uuid
  parentOrg   Organization?  @relation("OrganizationHierarchy", fields: [parentOrgId], references: [id], onDelete: SetNull)
  childOrgs   Organization[] @relation("OrganizationHierarchy")
  tenantParentOrg Organization?  @relation("TenantOrganizationHierarchy", fields: [tenantId, parentOrgId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "Organization_tenant_parent_fkey")
  tenantChildOrgs Organization[] @relation("TenantOrganizationHierarchy")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                    Role[]
  companyMemberships       CompanyMembership[]       @relation("CompanyMembershipCompany")
  tenantCompanyMemberships CompanyMembership[]       @relation("CompanyMembershipTenantCompany")
  branchMemberships        CompanyMembership[]       @relation("CompanyMembershipBranch")
  ownedOrders              Order[]                   @relation("OrderOwnerOrganization")
  assignedOrders           Order[]                   @relation("OrderAssignedOrganization")
  tenantOwnedOrders        Order[]                   @relation("OrderTenantOwnerOrganization")
  tenantAssignedOrders     Order[]                   @relation("OrderTenantAssignedOrganization")
  ownedSupportTickets      SupportTicket[]           @relation("SupportTicketOwnerOrganization")
  tenantOwnedSupportTickets SupportTicket[] @relation("SupportTenantOwner")
  tenantAssignedSupportTickets SupportTicket[] @relation("SupportTenantAssigned")
  assignedSupportTickets   SupportTicket[]           @relation("SupportTicketAssignedOrganization")
  paymentProviderConfigs   PaymentProviderConfig[]
  companyPaymentSetting    CompanyPaymentSetting?
  paymentIntents           PaymentIntent[]
  paymentWebhookEvents     PaymentWebhookEvent[]
  paymentLedgerEntries     PaymentLedgerEntry[]
  paymentRefunds           PaymentRefund[]
  invoices                 Invoice[]
  tenantInvoices           Invoice[]                 @relation("InvoiceTenantCompany")
  integrationProviders     IntegrationProvider[]
  integrationOutbox        IntegrationOutbox[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  routeTemplates           RouteTemplate[]
  carrierRoutingRules      CarrierRoutingRule[]
  supportQueues            SupportQueue[]            @relation("SupportQueueCompany")
  supportQueueDefaultOrgs  SupportQueue[]            @relation("SupportQueueDefaultOrg")
  supportAssignmentRules   SupportAssignmentRule[]   @relation("SupportAssignmentRuleCompany")
  supportSlaPolicies       SupportSlaPolicy[]        @relation("SupportSlaPolicyCompany")
  financeLegalEntity       FinanceLegalEntity?
  tenantFinanceLegalEntities FinanceLegalEntity[]    @relation("FinanceLegalEntityTenantCompany")
  financeSourceEvents      FinanceSourceEvent[]
  tenantNotifications      UserNotification[]          @relation("UserNotificationTenantCompany")
  tenantTariffPlans        TariffPlan[]                 @relation("TariffPlanTenantCompany")

  @@index([type, isActive])
  @@unique([tenantId, id], map: "Organization_tenant_identity_key")
  @@index([tenantId, type, isActive])
  @@index([parentOrgId])
}

model Warehouse {
  tenantSupportTickets SupportTicket[] @relation("SupportTenantWarehouse")
  id                  String                  @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name                String
  type                WarehouseType           @default(warehouse)
  location            String
  region              String?
  tenantId            String?                 @db.Uuid
  tenant              Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  latitude            Float?
  longitude           Float?
  users               User[]
  driverAccesses      DriverWarehouseAccess[]
  orders              Order[]
  tenantOrders        Order[] @relation("OrderTenantWarehouse")
  createdAt           DateTime                @default(now())
  tracking            Tracking[]
  heldCashCollections CashCollection[]        @relation("CashCollectionHolderWarehouse")
  originLegs          OrderLeg[]              @relation("OrderLegFromWarehouse")
  destinationLegs     OrderLeg[]              @relation("OrderLegToWarehouse")

  @@index([createdAt])
  @@unique([tenantId, id], map: "Warehouse_tenant_identity_key")
  @@index([tenantId, createdAt])
  @@index([latitude, longitude])
}

model DriverWarehouseAccess {
  id          String   @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  driverId    String   @db.Uuid
  warehouseId String   @db.Uuid
  createdAt   DateTime @default(now())

  driver    User      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([driverId, warehouseId])
  @@index([driverId])
  @@index([warehouseId])
}
