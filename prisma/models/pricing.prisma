// CargoPilot bounded-context Prisma declarations.
// Loaded through the multi-file schema configured in prisma.config.ts.

enum PricingPlanStatus {
  draft
  active
  archived
}

enum TariffPriceType {
  bucket
  linear
}

enum TariffPricingStrategy {
  FIXED_LANE
  LEG_TRANSIT
}

enum TariffCoverageType {
  domestic
  international
}

enum TariffTransportMode {
  ROAD
  AIR
  SEA
  RAIL
  COURIER
  MULTIMODAL
}

model PricingRegion {
  id                     String            @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  code                   String            @unique
  name                   String
  aliases                String[]          @default([])
  sortOrder              Int               @default(0)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  originZoneEntries      ZoneMatrixEntry[] @relation("ZoneMatrixOrigin")
  destinationZoneEntries ZoneMatrixEntry[] @relation("ZoneMatrixDestination")
  originSlaRules         DeliverySlaRule[] @relation("DeliverySlaOriginRegion")
  destinationSlaRules    DeliverySlaRule[] @relation("DeliverySlaDestinationRegion")

  @@index([isActive, sortOrder])
  @@index([name])
}

model ZoneMatrixEntry {
  id                  String        @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  originRegionId      String        @db.Uuid
  originRegion        PricingRegion @relation("ZoneMatrixOrigin", fields: [originRegionId], references: [id])
  destinationRegionId String        @db.Uuid
  destinationRegion   PricingRegion @relation("ZoneMatrixDestination", fields: [destinationRegionId], references: [id])
  zone                Int
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([originRegionId, destinationRegionId])
  @@index([zone])
}

model TariffPlan {
  contentGeneration Int @default(0)
  approvedVersionId String? @db.Uuid
  approvedDecision TariffPublicationDecisionKind?
  approvedPublication TariffPublicationDecision? @relation("TariffPublishedPointer", fields: [approvedVersionId, id, tenantId, companyId, approvedDecision], references: [versionId, planId, tenantId, companyId, decision], onDelete: Restrict, onUpdate: Restrict, map: "TariffPlan_approved_pointer_fkey")
  versions TariffConfigurationVersion[]
  @@unique([id, tenantId, companyId], map: "TariffPlan_version_owner_key")
  id                     String                @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  tenantId               String?               @db.Uuid
  tenant                 Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyId              String?               @db.Uuid
  tenantCompany          Organization?         @relation("TariffPlanTenantCompany", fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "TariffPlan_tenant_company_fkey")
  name                   String
  code                   String?               @unique
  description            String?
  status                 PricingPlanStatus     @default(draft)
  serviceType            ServiceType
  priceType              TariffPriceType       @default(bucket)
  pricingStrategy        TariffPricingStrategy @default(FIXED_LANE)
  coverageType           TariffCoverageType    @default(domestic)
  transportMode          TariffTransportMode   @default(ROAD)
  originCountryCode      String?
  destinationCountryCode String?
  transitPricingConfig   Json?
  routeTemplateId        String?               @db.Uuid
  routeTemplate          RouteTemplate?        @relation(fields: [companyId, routeTemplateId], references: [companyId, id], onDelete: Restrict, onUpdate: Restrict, map: "TariffPlan_company_route_template_fkey")
  currency               String                @default("UZS")
  priority               Int                   @default(0)
  isDefault              Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  customerEntityId       String?               @db.Uuid
  customerEntity         CustomerEntity?       @relation(fields: [tenantId, customerEntityId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "TariffPlan_tenant_customer_fkey")
  rates                  TariffRate[]

  @@index([status, serviceType, priority])
  @@index([tenantId, companyId, status, serviceType, priority], map: "TariffPlan_tenant_company_status_serviceType_priority_idx")
  @@index([customerEntityId, status])
  @@index([coverageType, transportMode, status])
  @@index([originCountryCode, destinationCountryCode])
  @@index([routeTemplateId, status])
}

enum TariffPublicationDecisionKind {
  approved
  rejected
}

model TariffConfigurationVersion {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  planId String @db.Uuid
  sourceGeneration Int
  contentSha256 String @db.Char(64)
  content Json
  actorUserId String @db.Uuid
  companyMembershipId String @db.Uuid
  tenantMembershipId String @db.Uuid
  operationId String @db.Uuid
  intentSha256 String @db.Char(64)
  reason String
  proposedAt DateTime @default(now())
  plan TariffPlan @relation(fields: [planId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "TariffVersion_owner_fkey")
  actor CompanyMembership @relation("TariffVersionActor", fields: [companyMembershipId, actorUserId, tenantId, companyId], references: [id, userId, tenantId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "TariffVersion_actor_fkey")
  bridge CompanyMembership @relation("TariffVersionBridge", fields: [companyMembershipId, tenantMembershipId, actorUserId, tenantId], references: [id, tenantMembershipId, userId, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "TariffVersion_bridge_fkey")
  decisions TariffPublicationDecision[] @relation("TariffDecisionSource")
  makerDecisions TariffPublicationDecision[] @relation("TariffDecisionMaker")
  supersedingDecisions TariffPublicationDecision[] @relation("TariffDecisionPrevious")
  @@unique([tenantId, operationId], map: "TariffVersion_operation_key")
  @@unique([planId, sourceGeneration], map: "TariffVersion_generation_key")
  @@unique([id, planId, tenantId, companyId, sourceGeneration, contentSha256], map: "TariffVersion_content_key")
  @@unique([id, planId, tenantId, companyId], map: "TariffVersion_owner_key")
  @@unique([id, actorUserId], map: "TariffVersion_maker_key")
  @@index([tenantId, companyId, planId, proposedAt], map: "TariffVersion_owner_idx")
}

model TariffPublicationDecision {
  versionId String @id @db.Uuid
  tenantId String @db.Uuid
  companyId String @db.Uuid
  planId String @db.Uuid
  sourceGeneration Int
  contentSha256 String @db.Char(64)
  decision TariffPublicationDecisionKind
  makerUserId String @db.Uuid
  actorUserId String @db.Uuid
  companyMembershipId String @db.Uuid
  tenantMembershipId String @db.Uuid
  operationId String @db.Uuid
  intentSha256 String @db.Char(64)
  reason String
  previousVersionId String? @db.Uuid
  decidedAt DateTime @default(now())
  source TariffConfigurationVersion @relation("TariffDecisionSource", fields: [versionId, planId, tenantId, companyId, sourceGeneration, contentSha256], references: [id, planId, tenantId, companyId, sourceGeneration, contentSha256], onDelete: Restrict, onUpdate: Restrict, map: "TariffDecision_content_fkey")
  makerProof TariffConfigurationVersion @relation("TariffDecisionMaker", fields: [versionId, makerUserId], references: [id, actorUserId], onDelete: Restrict, onUpdate: Restrict, map: "TariffDecision_maker_fkey")
  actor CompanyMembership @relation("TariffDecisionActor", fields: [companyMembershipId, actorUserId, tenantId, companyId], references: [id, userId, tenantId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "TariffDecision_actor_fkey")
  bridge CompanyMembership @relation("TariffDecisionBridge", fields: [companyMembershipId, tenantMembershipId, actorUserId, tenantId], references: [id, tenantMembershipId, userId, tenantId], onDelete: Restrict, onUpdate: Restrict, map: "TariffDecision_bridge_fkey")
  previous TariffConfigurationVersion? @relation("TariffDecisionPrevious", fields: [previousVersionId, planId, tenantId, companyId], references: [id, planId, tenantId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "TariffDecision_previous_fkey")
  publishedPlans TariffPlan[] @relation("TariffPublishedPointer")
  @@unique([tenantId, operationId], map: "TariffDecision_operation_key")
  @@unique([versionId, planId, tenantId, companyId, decision], map: "TariffDecision_pointer_key")
  @@index([tenantId, companyId, decidedAt], map: "TariffDecision_owner_idx")
}

model TariffRate {
  id           String     @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  tariffPlanId String     @db.Uuid
  tariffPlan   TariffPlan @relation(fields: [tariffPlanId], references: [id], onDelete: Cascade)
  zone         Int
  weightFromKg Decimal    @db.Decimal(10, 2)
  weightToKg   Decimal    @db.Decimal(10, 2)
  price        Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([tariffPlanId, zone, weightFromKg, weightToKg])
  @@index([tariffPlanId, zone])
}

model DeliverySlaRule {
  id                  String         @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name                String
  description         String?
  serviceType         ServiceType
  originRegionId      String?        @db.Uuid
  originRegion        PricingRegion? @relation("DeliverySlaOriginRegion", fields: [originRegionId], references: [id])
  destinationRegionId String?        @db.Uuid
  destinationRegion   PricingRegion? @relation("DeliverySlaDestinationRegion", fields: [destinationRegionId], references: [id])
  zone                Int?
  deliveryDays        Int
  priority            Int            @default(0)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  orders              Order[]

  @@index([serviceType, isActive, priority])
  @@index([originRegionId, destinationRegionId])
  @@index([zone])
}

model OperationalSlaPolicy {
  id                String   @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  singletonKey      String   @unique @default("global")
  staleHours        Int      @default(48)
  dueSoonHours      Int      @default(24)
  overdueGraceHours Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
