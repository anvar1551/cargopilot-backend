// CargoPilot bounded-context Prisma declarations.
// Loaded through the multi-file schema configured in prisma.config.ts.

model AnalyticsDomainEventOutbox {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  eventId       String   @unique
  type          String
  tenantScope   String
  entityId      String?
  schemaVersion Int      @default(1)
  occurredAt    DateTime
  payload       Json

  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt, createdAt])
  @@index([type, createdAt])
}
