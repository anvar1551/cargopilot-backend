// CargoPilot bounded-context Prisma declarations.
// Loaded through the multi-file schema configured in prisma.config.ts.

enum InvoiceStatus {
  pending
  issued
  paid
  cancelled
  credited
}

enum PaymentProvider {
  CLICK
  PAYME
  UZUM
  STRIPE
}

enum PaymentEnvironment {
  TEST
  PRODUCTION
}

enum PaymentIntentStatus {
  PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  SENT
  ACCEPTED
  REJECTED
  ERROR
}

enum PaymentWebhookProcessStatus {
  RECEIVED
  PROCESSED
  IGNORED_DUPLICATE
  FAILED
}

enum PaymentRefundStatus {
  requested
  processing
  succeeded
  failed
  cancelled
}

model CompanyPaymentSetting {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  companyId String       @unique @db.Uuid
  company   Organization @relation(fields: [companyId], references: [id], onDelete: Cascade)

  onlinePaymentsEnabled Boolean          @default(true)
  defaultProvider       PaymentProvider?
  allowProviderOverride Boolean          @default(true)

  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([onlinePaymentsEnabled, updatedAt])
}

model PaymentProviderConfig {
  id              String             @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId       String             @db.Uuid
  company         Organization       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  environment     PaymentEnvironment @default(TEST)
  isEnabled       Boolean            @default(true)
  merchantId      String?
  serviceId       String?
  accountId       String?
  secretEncrypted String
  secretMasked    String
  callbackPath    String
  createdByUserId String?            @db.Uuid
  updatedByUserId String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  paymentIntents  PaymentIntent[]
  ownedPaymentIntents PaymentIntent[] @relation("PaymentIntentOwnedConfig")
  @@unique([id, companyId, provider, environment], map: "PaymentProviderConfig_execution_key")

  @@unique([companyId, provider, environment], map: "uniq_provider_per_company_env")
  @@index([companyId, isEnabled])
  ownedFinanceHeaders FinanceProviderSettlement[] @relation("SettlementCompanyProvider")
  @@unique([id, companyId])
}

model PaymentIntent {
  reservationTenantId String? @db.Uuid
  reservationInvoiceId String? @db.Uuid
  reservationLegalEntityId String? @db.Uuid
  reservationAcceptedAt DateTime?
  reservationIssuedAt DateTime?
  reservationRequestHash String? @db.VarChar(64)
  reservationAuthorityHash String? @db.VarChar(64)
  reservationOrder Order? @relation("PaymentReservationOrder", fields: [reservationTenantId, orderId, companyId], references: [tenantId, id, ownerOrgId], onDelete: Restrict, onUpdate: Restrict, map: "PaymentReservation_order_fkey")
  reservationInvoice Invoice? @relation("PaymentReservationInvoice", fields: [reservationTenantId, reservationInvoiceId, orderId, companyId, currency], references: [tenantId, id, orderId, companyId, currency], onDelete: Restrict, onUpdate: Restrict, map: "PaymentReservation_invoice_fkey")
  reservationEntity FinanceLegalEntity? @relation("PaymentReservationEntity", fields: [reservationLegalEntityId, reservationTenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict, onUpdate: Restrict, map: "PaymentReservation_entity_fkey")
  @@index([reservationTenantId, companyId, reservationLegalEntityId], map: "PaymentReservation_owner_idx")
  ownedOrder Order @relation("PaymentIntentOwnedOrder", fields: [orderId, companyId], references: [id, ownerOrgId], onDelete: Restrict, onUpdate: Restrict, map: "PaymentIntent_order_owner_fkey")
  ownedProviderConfig PaymentProviderConfig @relation("PaymentIntentOwnedConfig", fields: [providerConfigId, companyId, provider, environment], references: [id, companyId, provider, environment], onDelete: Restrict, onUpdate: Restrict, map: "PaymentIntent_provider_context_fkey")
  ownedRefunds PaymentRefund[] @relation("PaymentRefundOwnedIntent")
  ownedLedgerEntries PaymentLedgerEntry[] @relation("PaymentLedgerOwnedIntent")
  @@unique([id, companyId, orderId, provider, environment, currency], map: "PaymentIntent_refund_source_key")
  @@unique([id, companyId, orderId, provider, currency], map: "PaymentIntent_ledger_source_key")
  settlementLines FinanceProviderSettlementLine[] @relation("SettlementLineIntent")
  @@unique([id, companyId, orderId, providerConfigId, currency], map: "PaymentIntent_settlement_owner_key")
  id                  String                @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId           String                @db.Uuid
  company             Organization          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId             String                @db.Uuid
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            PaymentProvider
  providerConfigId    String                @db.Uuid
  providerConfig      PaymentProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  environment         PaymentEnvironment
  amountMinor         BigInt
  currency            String
  status              PaymentIntentStatus   @default(PENDING)
  providerPaymentId   String?
  providerInvoiceId   String?
  providerCheckoutUrl String?
  idempotencyKey      String
  metadataJson        Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  attempts            PaymentAttempt[]
  webhooks            PaymentWebhookEvent[]
  ledgerEntries       PaymentLedgerEntry[]
  refunds             PaymentRefund[]

  @@unique([companyId, idempotencyKey], map: "uniq_intent_idempotency_per_company")
  @@index([companyId, orderId])
  @@index([companyId, status])
  // Ingress has only the external booking reference before deriving its owner.
  // Non-unique: ambiguity remains a rejection, never an inferred owner.
  @@index([provider, providerInvoiceId], map: "PaymentIntent_provider_booking_idx")
  @@index([provider, providerPaymentId], map: "PaymentIntent_provider_payment_idx")
}

model PaymentRefund {
  ownedIntent PaymentIntent @relation("PaymentRefundOwnedIntent", fields: [paymentIntentId, companyId, orderId, provider, environment, currency], references: [id, companyId, orderId, provider, environment, currency], onDelete: Restrict, onUpdate: Restrict, map: "PaymentRefund_intent_context_fkey")
  settlementLines FinanceProviderSettlementLine[] @relation("SettlementLineRefund")
  @@unique([id, companyId, orderId, paymentIntentId, currency], map: "PaymentRefund_settlement_owner_key")
  id                   String              @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId            String              @db.Uuid
  company              Organization        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentIntentId      String              @db.Uuid
  paymentIntent        PaymentIntent       @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  orderId              String              @db.Uuid
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider             PaymentProvider
  environment          PaymentEnvironment
  amountMinor          BigInt
  currency             String              @db.VarChar(3)
  status               PaymentRefundStatus @default(requested)
  providerRefundId     String?
  reason               String?
  idempotencyKey       String
  requestedByUserId    String              @db.Uuid
  providerResponseJson Json?
  failureCode          String?
  failureMessage       String?
  requestedAt          DateTime            @default(now())
  completedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([companyId, idempotencyKey])
  @@index([paymentIntentId, status, createdAt])
  @@index([companyId, status, createdAt])
  @@index([orderId, createdAt])
}

model PaymentAttempt {
  id              String               @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  paymentIntentId String               @db.Uuid
  paymentIntent   PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  status          PaymentAttemptStatus @default(CREATED)
  requestJson     Json?
  responseJson    Json?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([paymentIntentId, createdAt])
}

model PaymentWebhookEvent {
  id              String                      @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId       String?                     @db.Uuid
  company         Organization?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  provider        PaymentProvider
  environment     PaymentEnvironment
  externalEventId String?
  idempotencyKey  String
  signatureValid  Boolean                     @default(false)
  processStatus   PaymentWebhookProcessStatus @default(RECEIVED)
  headersJson     Json?
  payloadJson     Json
  errorMessage    String?
  receivedAt      DateTime                    @default(now())
  processedAt     DateTime?
  paymentIntentId String?                     @db.Uuid
  paymentIntent   PaymentIntent?              @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, environment, idempotencyKey], map: "uniq_webhook_provider_env_idempotency")
  @@index([provider, receivedAt])
  @@index([companyId, processStatus])
}

model PaymentLedgerEntry {
  ownedIntent PaymentIntent @relation("PaymentLedgerOwnedIntent", fields: [paymentIntentId, companyId, orderId, provider, currency], references: [id, companyId, orderId, provider, currency], onDelete: Restrict, onUpdate: Restrict, map: "PaymentLedgerEntry_intent_context_fkey")
  id              String          @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId       String          @db.Uuid
  company         Organization    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentIntentId String          @db.Uuid
  paymentIntent   PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  orderId         String          @db.Uuid
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  entryType       String
  amountMinor     BigInt
  currency        String
  provider        PaymentProvider
  reference       String?
  occurredAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([companyId, orderId])
  @@index([companyId, occurredAt])
}

model Invoice {
  InvoiceIssuanceReceipt_invoice InvoiceIssuanceReceipt[] @relation("InvoiceIssuanceReceipt_invoice")
  billingPriceApprovalId String? @db.Uuid
  billingPolicyVersionId String? @db.Uuid
  billingPayerCustomerEntityId String? @db.Uuid
  billingLegalEntityId String? @db.Uuid
  billingOrderBillToId String? @db.Uuid
  billingPrice OrderPriceApproval? @relation("InvoiceAcceptedPrice", fields: [billingPriceApprovalId, tenantId, companyId, billingLegalEntityId, orderId, currency, amount, billingOrderBillToId, billingPayerCustomerEntityId, billingPolicyVersionId], references: [snapshotId, tenantId, companyId, legalEntityId, orderId, currency, total, billToId, payerCustomerEntityId, policyVersionId], onDelete: Restrict, onUpdate: Restrict, map: "Invoice_accepted_price_fk")
  billingPolicy BillingPolicyVersion? @relation("InvoiceBillingPolicy", fields: [billingPolicyVersionId, tenantId, companyId, billingLegalEntityId, currency], references: [id, tenantId, companyId, legalEntityId, currency], onDelete: Restrict, onUpdate: Restrict, map: "Invoice_billing_policy_fk")
  @@unique([id, tenantId, companyId, orderId, billingLegalEntityId, currency, amount, billingPriceApprovalId], map: "Invoice_issuance_source_key")
  paymentReservations PaymentIntent[] @relation("PaymentReservationInvoice")
  @@unique([tenantId, id, orderId, companyId, currency], map: "Invoice_reservation_source_key")
  id               String        @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  tenantId         String?       @db.Uuid
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companyId        String        @db.Uuid
  company          Organization  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tenantCompany    Organization? @relation("InvoiceTenantCompany", fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "Invoice_tenant_company_fkey")
  orderId          String        @unique @db.Uuid
  customerId       String        @db.Uuid
  customerEntityId String?       @db.Uuid
  invoiceNumber    String
  amount           Decimal       @db.Decimal(20, 4)
  currency         String        @db.VarChar(3)
  fxRate           Decimal       @default(1) @db.Decimal(20, 10)
  fxRateAsOf       DateTime?
  status           InvoiceStatus @default(pending)
  paymentUrl       String?
  invoiceKey       String?
  issuedByUserId   String?       @db.Uuid
  issuedAt         DateTime?
  dueAt            DateTime?
  metadataJson     Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  tenantOwnedOrder Order?        @relation("InvoiceTenantOwnedOrder", fields: [tenantId, orderId, companyId], references: [tenantId, id, ownerOrgId], onDelete: Restrict, onUpdate: Restrict, map: "Invoice_tenant_order_owner_fkey")
  customer       User            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerEntity CustomerEntity? @relation(fields: [customerEntityId], references: [id], onDelete: Restrict)

  @@unique([companyId, invoiceNumber])
  @@unique([tenantId, id], map: "Invoice_tenant_identity_key")
  @@unique([tenantId, orderId, companyId], map: "Invoice_tenant_order_company_key")
  @@index([tenantId, status, createdAt])
  @@index([companyId, status, createdAt])
  @@index([customerEntityId, createdAt])
  @@index([status, createdAt])
}
