// CargoPilot bounded-context Prisma declarations.
// Loaded through the multi-file schema configured in prisma.config.ts.

enum OrderLabelJobStatus {
  pending
  processing
  completed
  failed
}

model OrderLabelJob {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  orderId String @unique @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id])

  ownershipTenantId  String? @db.Uuid
  ownershipCompanyId String? @db.Uuid
  acceptedAt DateTime?
  capability String?
  ownedOrder Order? @relation("AcceptedLabelOrder", fields: [ownershipTenantId, orderId, ownershipCompanyId], references: [tenantId, id, ownerOrgId], onDelete: Restrict, onUpdate: Restrict, map: "OrderLabelJob_accepted_order_fkey")

  status      OrderLabelJobStatus @default(pending)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  error       String?
  availableAt DateTime            @default(now())
  lockedAt    DateTime?
  lockedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([ownershipTenantId, ownershipCompanyId, status], map: "OrderLabelJob_tenant_company_status_idx")
}
