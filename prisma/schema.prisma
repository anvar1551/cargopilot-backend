model Organization {
  id   String           @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name String
  type OrganizationType
  code String?          @unique

  parentOrgId String?        @db.Uuid
  parentOrg   Organization?  @relation("OrganizationHierarchy", fields: [parentOrgId], references: [id], onDelete: SetNull)
  childOrgs   Organization[] @relation("OrganizationHierarchy")

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles                    Role[]
  companyMemberships       CompanyMembership[]       @relation("CompanyMembershipCompany")
  branchMemberships        CompanyMembership[]       @relation("CompanyMembershipBranch")
  ownedOrders              Order[]                   @relation("OrderOwnerOrganization")
  assignedOrders           Order[]                   @relation("OrderAssignedOrganization")
  ownedSupportTickets      SupportTicket[]           @relation("SupportTicketOwnerOrganization")
  assignedSupportTickets   SupportTicket[]           @relation("SupportTicketAssignedOrganization")
  paymentProviderConfigs   PaymentProviderConfig[]
  companyPaymentSetting    CompanyPaymentSetting?
  paymentIntents           PaymentIntent[]
  paymentWebhookEvents     PaymentWebhookEvent[]
  paymentLedgerEntries     PaymentLedgerEntry[]
  integrationProviders     IntegrationProvider[]
  integrationOutbox        IntegrationOutbox[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  routeTemplates           RouteTemplate[]
  carrierRoutingRules      CarrierRoutingRule[]
  supportQueues            SupportQueue[]           @relation("SupportQueueCompany")
  supportQueueDefaultOrgs  SupportQueue[]           @relation("SupportQueueDefaultOrg")
  supportAssignmentRules   SupportAssignmentRule[]  @relation("SupportAssignmentRuleCompany")
  supportSlaPolicies       SupportSlaPolicy[]       @relation("SupportSlaPolicyCompany")

  @@index([type, isActive])
  @@index([parentOrgId])
}

model CompanyPaymentSetting {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  companyId String       @unique @db.Uuid
  company   Organization @relation(fields: [companyId], references: [id], onDelete: Cascade)

  onlinePaymentsEnabled Boolean          @default(true)
  defaultProvider       PaymentProvider?
  allowProviderOverride Boolean          @default(true)

  createdByUserId String?  @db.Uuid
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([onlinePaymentsEnabled, updatedAt])
}

model Role {
  id   String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  code String
  name String

  companyId String?       @db.Uuid
  company   Organization? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  isSystem    Boolean  @default(false)
  isOwnerRole Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([companyId, code])
  @@index([code])
  @@index([companyId, isSystem])
}

model Permission {
  id          String  @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([resource, action])
}

model RolePermission {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model CompanyMembership {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String       @db.Uuid
  company   Organization @relation("CompanyMembershipCompany", fields: [companyId], references: [id], onDelete: Cascade)

  branchId String?       @db.Uuid
  branch   Organization? @relation("CompanyMembershipBranch", fields: [branchId], references: [id], onDelete: SetNull)

  status MembershipStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles  MembershipRole[]
  scopes MembershipScope[]

  @@unique([userId, companyId])
  @@index([companyId, status])
  @@index([branchId])
}

model MembershipRole {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  membershipId String            @db.Uuid
  membership   CompanyMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String            @db.Uuid
  role         Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([membershipId, roleId])
  @@index([roleId])
}

model MembershipScope {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  membershipId String              @db.Uuid
  membership   CompanyMembership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  scopeType    MembershipScopeType
  scopeRefId   String              @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([membershipId, scopeType, scopeRefId])
  @@index([scopeType, scopeRefId])
  @@index([membershipId])
}

model User {
  id       String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name     String
  email    String @unique
  password String

  driverType            DriverType?
  liveLocationEnabled   Boolean             @default(true)
  liveLocationUpdatedAt DateTime            @default(now())
  memberships           CompanyMembership[]

  // ✅ link user -> customer entity (person/company)
  customerEntityId String?         @db.Uuid
  customerEntity   CustomerEntity? @relation("CustomerEntityUsers", fields: [customerEntityId], references: [id])

  warehouseId       String?                 @db.Uuid
  warehouse         Warehouse?              @relation(fields: [warehouseId], references: [id])
  warehouseAccesses DriverWarehouseAccess[]

  orders       Order[] @relation("CustomerOrders")
  driverOrders Order[] @relation("DriverOrders")

  createdAt DateTime @default(now())

  invoices                  Invoice[]
  trackingEvents            Tracking[]            @relation("TrackingActor")
  heldCashCollections       CashCollection[]      @relation("CashCollectionHolderUser")
  cashCollectionActorEvents CashCollectionEvent[] @relation("CashCollectionEventActor")
  notifications             UserNotification[]
  createdOrderDocuments     OrderDocument[]       @relation("OrderDocumentCreatedBy")
  refreshSessions           UserRefreshSession[]

  @@index([createdAt])
  @@index([warehouseId, createdAt])
}

model Warehouse {
  id                  String                  @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  name                String
  type                WarehouseType           @default(warehouse)
  location            String
  region              String?
  latitude            Float?
  longitude           Float?
  users               User[]
  driverAccesses      DriverWarehouseAccess[]
  orders              Order[]
  createdAt           DateTime                @default(now())
  tracking            Tracking[]
  heldCashCollections CashCollection[]        @relation("CashCollectionHolderWarehouse")
  originLegs          OrderLeg[]              @relation("OrderLegFromWarehouse")
  destinationLegs     OrderLeg[]              @relation("OrderLegToWarehouse")

  @@index([createdAt])
  @@index([latitude, longitude])
}

model DriverWarehouseAccess {
  id          String   @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  driverId    String   @db.Uuid
  warehouseId String   @db.Uuid
  createdAt   DateTime @default(now())

  driver    User      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([driverId, warehouseId])
  @@index([driverId])
  @@index([warehouseId])
}

model Order {
  id String @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid

  // ✅ human readable number like 99000021
  orderNumber String @unique

  status OrderStatus @default(pending)

  // ---------------- Sender / Receiver (basic quick fields - keep for now) ----------------
  senderName      String?
  senderPhone     String?
  senderPhone2    String?
  senderPhone3    String?
  senderAddress   String? // keep legacy text field (optional)
  receiverName    String?
  receiverPhone   String?
  receiverPhone2  String?
  receiverPhone3  String?
  receiverAddress String? // keep legacy text field (optional)

  // ---------------- Legacy quick addresses (still used in UI today) ----------------
  pickupAddress   String
  dropoffAddress  String
  destinationCity String?
  pickupLat       Float?
  pickupLng       Float?
  dropoffLat      Float?
  dropoffLng      Float?

  // ---------------- Service/payment info (Stripe optional later) ----------------
  serviceType ServiceType?
  codAmount   Float?
  currency    String?
  weightKg    Float?

  // ---------------- Owner/customer (auth user) ----------------
  customerId String @db.Uuid
  customer   User   @relation("CustomerOrders", fields: [customerId], references: [id])

  // ---------------- Customer master (company/person) ----------------
  customerEntityId String?         @db.Uuid
  customerEntity   CustomerEntity? @relation("CustomerEntityOrders", fields: [customerEntityId], references: [id])

  // ---------------- Structured addresses (competitor-like) ----------------
  senderAddressId  String?  @db.Uuid
  senderAddressObj Address? @relation("OrderSenderAddress", fields: [senderAddressId], references: [id])

  receiverAddressId  String?  @db.Uuid
  receiverAddressObj Address? @relation("OrderReceiverAddress", fields: [receiverAddressId], references: [id])

  // ---------------- Operations ----------------
  assignedDriverId String? @db.Uuid
  assignedDriver   User?   @relation("DriverOrders", fields: [assignedDriverId], references: [id])

  currentWarehouseId String?    @db.Uuid
  currentWarehouse   Warehouse? @relation(fields: [currentWarehouseId], references: [id])

  ownerOrgId    String?       @db.Uuid
  ownerOrg      Organization? @relation("OrderOwnerOrganization", fields: [ownerOrgId], references: [id], onDelete: SetNull)
  assignedOrgId String?       @db.Uuid
  assignedOrg   Organization? @relation("OrderAssignedOrganization", fields: [assignedOrgId], references: [id], onDelete: SetNull)

  labelKey String?

  // ---------------- Relations ----------------
  parcels              Parcel[]
  trackingEvents       Tracking[]
  labelJob             OrderLabelJob?
  invoice              Invoice?
  attachments          OrderAttachment[]
  cashCollections      CashCollection[]
  supportTickets       SupportTicket[]
  legs                 OrderLeg[]
  pricingComponents    PricingComponent[]
  documents            OrderDocument[]
  paymentIntents       PaymentIntent[]
  paymentLedgerEntries PaymentLedgerEntry[]

  // ---------------- Attempt counters ----------------
  pickupAttemptCount   Int @default(0)
  deliveryAttemptCount Int @default(0)

  // ---------------- Exception snapshot ----------------
  lastExceptionReason ReasonCode?
  lastExceptionAt     DateTime?

  // ---------------- Scheduling ----------------
  plannedPickupAt    DateTime?
  plannedDeliveryAt  DateTime?
  expectedDeliveryAt DateTime?
  slaSource          OrderSlaSource?
  slaRuleId          String?          @db.Uuid
  slaRule            DeliverySlaRule? @relation(fields: [slaRuleId], references: [id])
  slaTargetDays      Int?

  // ---------------- Payment (competitor) ----------------
  paymentType             PaymentType?
  paymentState            OrderPaymentState           @default(UNPAID)
  deliveryChargePaidBy    PaidBy?
  ifRecipientNotAvailable RecipientUnavailableAction?

  codPaidStatus           PaidStatus?
  serviceCharge           Float?
  serviceChargePaidStatus PaidStatus?
  itemValue               Float?

  // ---------------- Additional / references (competitor-like) ----------------
  referenceId   String?
  shelfId       String?
  promoCode     String?
  numberOfCalls Int?
  promiseDate   DateTime?

  fragile           Boolean @default(false)
  dangerousGoods    Boolean @default(false)
  shipmentInsurance Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([assignedDriverId])
  @@index([currentWarehouseId])
  @@index([customerEntityId])
  @@index([status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([paymentState, createdAt])
  @@index([status, expectedDeliveryAt])
  @@index([expectedDeliveryAt])
  @@index([slaRuleId])
  @@index([currentWarehouseId, status, createdAt])
  @@index([currentWarehouseId, status, updatedAt])
  @@index([currentWarehouseId, updatedAt])
  @@index([assignedDriverId, status, createdAt])
  @@index([pickupLat, pickupLng])
  @@index([dropoffLat, dropoffLng])
  @@index([referenceId])
  @@index([ownerOrgId, status, createdAt])
  @@index([assignedOrgId, status, createdAt])
}

model PaymentProviderConfig {
  id              String             @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId       String             @db.Uuid
  company         Organization       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  environment     PaymentEnvironment @default(TEST)
  isEnabled       Boolean            @default(true)
  merchantId      String?
  serviceId       String?
  accountId       String?
  secretEncrypted String
  secretMasked    String
  callbackPath    String
  createdByUserId String?            @db.Uuid
  updatedByUserId String?            @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  paymentIntents  PaymentIntent[]

  @@unique([companyId, provider, environment], map: "uniq_provider_per_company_env")
  @@index([companyId, isEnabled])
}

model PaymentIntent {
  id                  String                @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId           String                @db.Uuid
  company             Organization          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderId             String                @db.Uuid
  order               Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider            PaymentProvider
  providerConfigId    String                @db.Uuid
  providerConfig      PaymentProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)
  environment         PaymentEnvironment
  amountMinor         BigInt
  currency            String
  status              PaymentIntentStatus   @default(PENDING)
  providerPaymentId   String?
  providerInvoiceId   String?
  providerCheckoutUrl String?
  idempotencyKey      String
  metadataJson        Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  attempts            PaymentAttempt[]
  webhooks            PaymentWebhookEvent[]
  ledgerEntries       PaymentLedgerEntry[]

  @@unique([companyId, idempotencyKey], map: "uniq_intent_idempotency_per_company")
  @@index([companyId, orderId])
  @@index([companyId, status])
}

model PaymentAttempt {
  id              String               @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  paymentIntentId String               @db.Uuid
  paymentIntent   PaymentIntent        @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  provider        PaymentProvider
  status          PaymentAttemptStatus @default(CREATED)
  requestJson     Json?
  responseJson    Json?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([paymentIntentId, createdAt])
}

model PaymentWebhookEvent {
  id              String                      @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId       String?                     @db.Uuid
  company         Organization?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  provider        PaymentProvider
  environment     PaymentEnvironment
  externalEventId String?
  idempotencyKey  String
  signatureValid  Boolean                     @default(false)
  processStatus   PaymentWebhookProcessStatus @default(RECEIVED)
  headersJson     Json?
  payloadJson     Json
  errorMessage    String?
  receivedAt      DateTime                    @default(now())
  processedAt     DateTime?
  paymentIntentId String?                     @db.Uuid
  paymentIntent   PaymentIntent?              @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@unique([provider, environment, idempotencyKey], map: "uniq_webhook_provider_env_idempotency")
  @@index([provider, receivedAt])
  @@index([companyId, processStatus])
}

model PaymentLedgerEntry {
  id              String          @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId       String          @db.Uuid
  company         Organization    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentIntentId String          @db.Uuid
  paymentIntent   PaymentIntent   @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)
  orderId         String          @db.Uuid
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  entryType       String
  amountMinor     BigInt
  currency        String
  provider        PaymentProvider
  reference       String?
  occurredAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  @@index([companyId, orderId])
  @@index([companyId, occurredAt])
}

model IntegrationProvider {
  id              String                    @id @default(dbgenerated("public.uuid_generate_v7()")) @db.Uuid
  companyId       String                    @db.Uuid
  company         Organization              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  domain          IntegrationDomain
  providerCode    String
  status          IntegrationProviderStatus @default(active)
  environment     IntegrationEnvironment    @default(sandbox)
  capabilities    String[]                  @default([])
  rateLimitRps    Int?
  timeoutMs       Int                       @default(10000)
  retryPolicyId   String?
  secretRef       String?
  createdByUserId String?                   @db.Uuid
  updatedByUserId String?                   @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  secrets                     IntegrationProviderSecret[]
  outboxRecords               IntegrationOutbox[]
  webhookEvents               IntegrationWebhookEvent[]
  canonicalEvents             IntegrationCanonicalEvent[]
  carrierRoutingRules         CarrierRoutingRule[]        @relation("CarrierRoutingRuleProvider")
  fallbackCarrierRoutingRules CarrierRoutingRule[]        @relation("CarrierRoutingRuleFallbackProvider")

